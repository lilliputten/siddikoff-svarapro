{
  "name": "svara-pro-bot",
  "version": "0.0.1",
  "description": "Telegram bot for Svara Pro WebApp",
  "type": "module",
  "scripts": {
    "dev-default": "cross-env NODE_ENV=development tsx src/index.ts",
    "dev": "nodemon --exec \"cross-env NODE_ENV=development tsx\" src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && [ -d src/assets ] && cp -r src/assets dist/ || echo 'Assets directory not found, skipping copy'",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write --cache .",
    "format-quick": "pretty-quick --write --cache .",
    "check-all": "npm-run-all format-quick lint type-check",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.2.0",
    "telegraf": "^4.16.3",
    "telegraf-ratelimit": "^2.0.0",
    "typescript-eslint": "^8.34.1"
  },
  "devDependencies": {
    "@telegraf/types": "^8.3.1",
    "@types/node": "^24.0.7",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "tsx": "^4.6.0",
    "typescript": "~5.8.3"
  }
}
